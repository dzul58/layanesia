# Kosong = same-origin. Di `npm run dev`, Vite mem-proxy /api dan /uploads ke backend.
# Production: isi origin API, contoh https://api.layanesia.id
VITE_API_BASE_URL=

# Client key Midtrans (Snap.js). Kosong = checkout memakai redirect_url, atau simulasi di mode dev.
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false
