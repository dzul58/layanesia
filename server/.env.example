# ============================================================
# Layanesia Server - Environment Configuration
# Salin ke .env untuk development. JANGAN commit file .env.
# Variabel bertanda [PROD WAJIB] akan membuat server menolak start
# di ENV=production jika kosong / tidak aman.
# ============================================================

PORT=8080
# development | staging | production | test
ENV=development

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres                 # [PROD WAJIB]
DB_NAME=layanesia_db
DB_SSLMODE=disable                   # [PROD WAJIB] require / verify-full
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# Jalankan migrasi SQL (db/migrations) saat server start. Default: true di dev, false di prod.
# Di production disarankan: go run ./cmd/migrate up  (sebagai step deploy terpisah)
DB_RUN_MIGRATIONS=true
# Log semua query SQL ke stdout. Default: true di dev, false di prod.
DB_LOG_QUERIES=true

# ---------- Auth ----------
JWT_SECRET=                          # [PROD WAJIB] minimal 32 karakter acak, contoh: openssl rand -base64 48
JWT_TTL=168h
ADMIN_API_KEY=                       # [PROD WAJIB] header X-Admin-Key untuk endpoint /admin/*

# ---------- HTTP ----------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000   # [PROD WAJIB] domain frontend, dipisah koma
BODY_LIMIT_MB=10
TRUSTED_PROXIES=                     # IP/CIDR reverse proxy (untuk X-Forwarded-For), dipisah koma

# ---------- Midtrans ----------
MIDTRANS_SERVER_KEY=                 # [PROD WAJIB]
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Endpoint POST /subscriptions/simulate-activate hanya aktif jika true. Harus false di production.
ENABLE_PAYMENT_SIMULATION=true

# ---------- Cloudinary (upload KTP & Resume) ----------
CLOUDINARY_CLOUD_NAME=               # [PROD WAJIB]
CLOUDINARY_API_KEY=                  # [PROD WAJIB]
CLOUDINARY_API_SECRET=               # [PROD WAJIB]
CLOUDINARY_FOLDER=layanesia

# ---------- Upload ----------
# Jika Cloudinary tidak dikonfigurasi (dev), file disimpan ke folder lokal ini.
UPLOAD_LOCAL_DIR=./uploads
UPLOAD_MAX_IMAGE_MB=3
UPLOAD_MAX_DOCUMENT_MB=5

# ---------- Verifikasi KTP ----------
# true = KTP langsung VERIFIED tanpa review admin (hanya untuk dev). Harus false di production.
KTP_AUTO_VERIFY=false
